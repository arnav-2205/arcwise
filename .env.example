# Port for the Express + Next server
PORT=3000

# GitHub sign-in. Create an OAuth App at https://github.com/settings/developers with the
# callback URL <ARCWISE_BASE_URL>/auth/github/callback (for local use: http://localhost:3000/auth/github/callback).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public URL of this server, used to build the OAuth callback URL.
ARCWISE_BASE_URL=http://localhost:3000
# Signs session cookies. At least 32 random characters. Required in production.
ARCWISE_SESSION_SECRET=
# Guest access ("Continue as guest"). Off by default: everyone creates an account.
ARCWISE_GUEST=0

# Optional. With a key set, Arcwise writes summaries, reviews risky code and rewrites prompts with Claude.
# Without it, summaries come from the code structure and prompt rewrites use deterministic rules.
ANTHROPIC_API_KEY=
# Model ids come from env only. Check the current Claude API docs for ids.
ARCWISE_MODEL_DEEP=
ARCWISE_MODEL_BULK=

# 32-byte key (hex or base64) used to encrypt provider keys saved for quality-gate replays.
ARCWISE_ENCRYPTION_KEY=

# Limits
ARCWISE_MAX_FILES=20000
ARCWISE_MAX_REPO_MB=500
